.gradle
**/build/
!src/**/build/

# Development client/server of the dungeon toolkit addon (see dungeon/build.gradle):
# new, with nothing versioned inside yet, so it is ignored whole instead of replicating the fine
# list below entry by entry.
dungeon/runClient/
dungeon/runServer/

runClient/logs/
runServer/logs/
runClient/crash-reports/
runServer/crash-reports/
runClient/saves/
runClient/world/
runServer/saves/
runServer/world/
runClient/usercache.json
runServer/usercache.json

# Regenerable test server/client state and third-party mod configs unrelated to dndsheets
# — they don't apply to what is already tracked, they only avoid re-adding it if it is deleted.
runServer/ops.json
runServer/whitelist.json
runServer/banned-ips.json
runServer/banned-players.json
runServer/servers.dat
runServer/servers.dat_old
runServer/usernamecache.json
runServer/options.txt
runServer/eula.txt
runServer/imgui.ini
runServer/config/CoroUtil/
runServer/config/watut-*
runServer/config/fml.toml
runServer/config/forge-client.toml
runClient/ops.json
runClient/whitelist.json
runClient/banned-ips.json
runClient/banned-players.json
runClient/servers.dat
runClient/servers.dat_old
runClient/usernamecache.json
runClient/options.txt
runClient/eula.txt
runClient/imgui.ini
runClient/config/CoroUtil/
runClient/config/watut-*
runClient/config/fml.toml
runClient/config/forge-client.toml

# empty sheet.json in both folders, and a copy of the default rules (dndsheets/{monsters,
# presets,spells,traits,weapons}.json) that runClient/ auto-generates from src/main/resources when
# starting with no data — it is regenerable state, the real source lives in src/main/resources/dndsheets/defaults.
runClient/sheet.json
runServer/sheet.json
runClient/dndsheets/monsters/monsters.json
runClient/dndsheets/presets/presets.json
runClient/dndsheets/spells/spells.json
runClient/dndsheets/traits/traits.json
runClient/dndsheets/weapons/weapons.json

# Local development artifacts that don't belong in the repo: bin/ is a leftover from another mod
# (MCreator, different mod-id) committed by mistake; crash/ and logs/ are diagnostics of a local
# session; patch/ is a working copy; lib/ must be resolved by Gradle (see dependencies in
# build.gradle), not versioned as a loose jar.
/bin/
/crash/
/logs/
/patch/
/lib/


# Claude Code: agent config/session cache, all local to each dev, none of this belongs to the project.
.claude/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# The third-party mods the integration is tested with. They aren't part of the repo and weigh
# hundreds of megabytes; tools/preflight_mods.py says which ones are needed.
runClient/mods/
runClient/mods-disabled/

# Development client screenshots: F2 generates them while testing, they aren't part of the repo.
runClient/screenshots/

# Knowledge graph generated by /graphify (graph.json weighs ~5 MB, it gets rebuilt).
graphify-out/

# Python bytecode of the tools/ scripts: regenerable, and it ties the repo to the local Python version.
__pycache__/

# Development client state that the mod itself regenerates. It was versioned and dirtied every
# `git status`: mod_defaults.json is rewritten by ContentDefaults ON EVERY STARTUP and it also reorders the
# entries, so a single startup gave a 2,700-line diff over identical content. What the DM
# writes by hand are the OTHER .json files in those folders, and those aren't here.
runClient/dndsheets/*/mod_defaults.json
runClient/charactersheets/

# Leftovers of the test client: copies the mod sets aside when deleting a character or migrating a pack.
*.json.deleted
*.json.old

# Configs of third-party mods used for testing (the mods themselves are already ignored, above).
runClient/config/embeddium-mixins.properties
runClient/config/ferritecore-mixin.toml

# The whole runGameTestServer directory, and not entry by entry like runClient/ and runServer/: those have
# files that ARE versioned (the content packs the game regenerates), but this is a
# throwaway server — world, logs, eula and config— that is created from scratch on every run.
runGameTest/
