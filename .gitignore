.gradle
**/build/
!src/**/build/

runClient/logs/
runServer/logs/
runClient/crash-reports/
runServer/crash-reports/
runClient/saves/
runClient/world/
runServer/saves/
runServer/world/
runClient/usercache.json
runServer/usercache.json

# Estado de servidor/cliente de pruebas regenerable y configs de mods de terceros ajenos a dndsheets
# — no aplican a lo ya trackeado, solo evitan volver a agregarlo si se borra.
runServer/ops.json
runServer/whitelist.json
runServer/banned-ips.json
runServer/banned-players.json
runServer/servers.dat
runServer/servers.dat_old
runServer/usernamecache.json
runServer/options.txt
runServer/eula.txt
runServer/imgui.ini
runServer/config/CoroUtil/
runServer/config/watut-*
runServer/config/fml.toml
runServer/config/forge-client.toml
runClient/ops.json
runClient/whitelist.json
runClient/banned-ips.json
runClient/banned-players.json
runClient/servers.dat
runClient/servers.dat_old
runClient/usernamecache.json
runClient/options.txt
runClient/eula.txt
runClient/imgui.ini
runClient/config/CoroUtil/
runClient/config/watut-*
runClient/config/fml.toml
runClient/config/forge-client.toml

# sheet.json vacío en ambas carpetas, y copia de las reglas por defecto (dndsheets/{monsters,
# presets,spells,traits,weapons}.json) que runClient/ auto-genera desde src/main/resources al
# arrancar sin datos — es estado regenerable, la fuente real vive en src/main/resources/dndsheets/defaults.
runClient/sheet.json
runServer/sheet.json
runClient/dndsheets/monsters/monsters.json
runClient/dndsheets/presets/presets.json
runClient/dndsheets/spells/spells.json
runClient/dndsheets/traits/traits.json
runClient/dndsheets/weapons/weapons.json

# Artefactos de desarrollo local que no pertenecen al repo: bin/ es un residuo de otro mod
# (MCreator, mod-id distinto) commiteado por error; crash/ y logs/ son diagnóstico de una sesión
# local; patch/ es una copia de trabajo; lib/ debe resolverse por Gradle (ver dependencies en
# build.gradle), no versionarse como jar suelto.
/bin/
/crash/
/logs/
/patch/
/lib/


# Claude Code: config/agentes/cache de sesión, todo local a cada dev, nada de esto es del proyecto.
.claude/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Los mods de terceros con los que se prueba la integracion. No son del repo y pesan
# cientos de megas; tools/preflight_mods.py dice cuales hacen falta.
runClient/mods/
runClient/mods-disabled/

# Capturas del cliente de desarrollo: las genera F2 al probar, no son del repo.
runClient/screenshots/

# Grafo de conocimiento generado por /graphify (graph.json pesa ~5 MB, se reconstruye).
graphify-out/
