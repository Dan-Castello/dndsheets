.gradle
**/build/
!src/**/build/

runClient/logs/
runServer/logs/
runClient/crash-reports/
runServer/crash-reports/
runClient/saves/
runClient/world/
runServer/saves/
runServer/world/
runClient/usercache.json
runServer/usercache.json

# Artefactos de desarrollo local que no pertenecen al repo (ver AUDIT_TECHNICAL.md QW-7/QW-8):
# bin/ es un residuo de otro mod (MCreator, mod-id distinto) commiteado por error; crash/ y logs/
# son diagnóstico de una sesión local; patch/ es una copia de trabajo; lib/ debe resolverse por
# Gradle (ver dependencies en build.gradle), no versionarse como jar suelto.
/bin/
/crash/
/logs/
/patch/
/lib/


# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath
